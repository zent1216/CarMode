<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg"
    android:padding="12dp"
    android:baselineAligned="false">

    <!-- ───────── 좌측: 지도 카드 (크게) ───────── -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="60"
        android:layout_marginEnd="12dp"
        android:background="@drawable/panel_bg"
        android:clipToOutline="true">

        <!-- 지도앱이 렌더링되는 표면 -->
        <SurfaceView
            android:id="@+id/t2MapSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 임베드 전/실패 시 안내 오버레이 -->
        <LinearLayout
            android:id="@+id/t2MapHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/t2MapHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="지정한 지도앱이 이 카드 안에서 실행됩니다.\n설정에서 지도앱을 먼저 지정하세요."
                android:textColor="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/t2MapStart"
                style="@style/TopButton"
                android:layout_marginTop="16dp"
                android:text="지도 실행" />
        </LinearLayout>

    </FrameLayout>

    <!-- ───────── 우측: 상단바 + 날씨 + 퀵실행 + 음악 ───────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="40"
        android:orientation="vertical">

        <!-- 상단 바: 작은 시계 · 상태아이콘 · 모든앱 · 설정 (편집 없음) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/t2TopTime"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:text="--:--"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1" />

            <!-- 시계와 아이콘 사이 여백(아이콘/버튼을 오른쪽으로 민다) -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/t2Wifi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_wifi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="와이파이" />

            <ImageView
                android:id="@+id/t2Bt"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_bluetooth"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="블루투스" />

            <ImageView
                android:id="@+id/t2Data"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_cellular"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="모바일 데이터" />

            <!-- 지도 재시작 (임베드 중에만 표시, 지도 위를 안 가리게 상단바로 이동) -->
            <TextView
                android:id="@+id/t2MapReload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="↻"
                android:textColor="@color/text_dim"
                android:textSize="18sp"
                android:visibility="gone"
                android:contentDescription="지도 재시작" />

            <TextView
                android:id="@+id/t2AllApps"
                style="@style/TopButton"
                android:layout_marginEnd="6dp"
                android:text="모든 앱" />

            <TextView
                android:id="@+id/t2Settings"
                style="@style/TopButton"
                android:text="설정" />
        </LinearLayout>

        <!-- 날씨 카드 (약간 작게) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_bg"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/t2WxLoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="위치 확인 중…"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/t2WxTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="@color/text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/t2WxDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/t2WxIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☁️"
                android:textSize="34sp" />
        </LinearLayout>

        <!-- 여백(위) — 빈 공간을 위아래로 나눠 균형 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 퀵실행: 아이콘 한 줄 (라벨 없음, 정사각형) -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/t2Grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowCount="1"
            app:useDefaultMargins="false" />

        <!-- 여백(아래) — 미디어를 아래로 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 음악(미디어) 카드 — 가로형, 앨범/글씨만 키움 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_bg"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/t2Art"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/album_bg"
                android:scaleType="centerCrop"
                android:clipToOutline="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/t2Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="재생 중인 곡 없음"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <TextView
                    android:id="@+id/t2Artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="음악 앱을 실행하세요"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/t2Prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:src="@drawable/ic_skip_prev"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/t2Play"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/play_btn_bg"
                android:padding="13dp"
                android:src="@drawable/ic_play"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/t2Next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:src="@drawable/ic_skip_next"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
