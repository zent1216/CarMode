<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="14dp">

    <!-- 상단 통합 라인 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="6dp">

        <!-- 왼쪽: 시계 + 날짜 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTopTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="--월 --일"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnAllApps"
                style="@style/TopButton"
                android:layout_marginEnd="10dp"
                android:text="모든 앱" />

            <TextView
                android:id="@+id/btnSettings"
                style="@style/TopButton"
                android:text="설정" />

            <TextView
                android:id="@+id/btnEdit"
                style="@style/TopButton"
                android:layout_marginStart="10dp"
                android:text="편집" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 본문 2단 (좌우 순서는 코드에서 동적으로 바꿈) -->
    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="3"
        android:baselineAligned="false">

        <!-- 위젯 패널 -->
        <ScrollView
            android:id="@+id/widgetPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/panel_bg"
            android:padding="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 날씨: 좌우 스와이프 (현재 / 주간) -->
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/wxPager"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="4dp" />

                <!-- 페이지 점 인디케이터 -->
                <LinearLayout
                    android:id="@+id/wxDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <!-- 음악 위젯 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/plArt"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/album_bg"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/plTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="재생 중인 곡 없음"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <TextView
                            android:id="@+id/plArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="음악 앱을 실행하세요"
                            android:textColor="@color/text_dim"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/plPrev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_skip_prev"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/plPlay"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_marginHorizontal="28dp"
                        android:background="@drawable/play_btn_bg"
                        android:padding="16dp"
                        android:src="@drawable/ic_play"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/plNext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_skip_next"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 타일 그리드 -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/tileGrid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginStart="16dp"
            app:columnCount="3"
            app:rowCount="2"
            app:useDefaultMargins="false" />
    </LinearLayout>
</LinearLayout>
