<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tile_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="78dp">

            <TextView
                android:id="@+id/tileIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="📱"
                android:textSize="52sp"
                android:gravity="center" />

            <ImageView
                android:id="@+id/tileIconImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="앱 이름"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tileSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileDelete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/delete_bg"
        android:gravity="center"
        android:text="×"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:visibility="gone" />

    <!-- tileCorner는 buildTile()에서 참조하므로 invisible 처리 -->
    <View
        android:id="@+id/tileCorner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
